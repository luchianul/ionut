{
  "name": "pontaj",
  "productName": "Pontaj",
  "version": "1.0.0",
  "description": "Pontaj angajati - aplicatie Windows (EXE) si Android (APK), date in Google Sheets",
  "main": "electron/main.js",
  "author": "luchianul",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "start": "electron .",
    "test:e2e": "node test/e2e.js",
    "dist:win": "electron-builder --win --publish never"
  },
  "dependencies": {
    "@capacitor/android": "^7.0.0",
    "@capacitor/cli": "^7.0.0",
    "@capacitor/core": "^7.0.0"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "ro.ionut.pontaj",
    "productName": "Pontaj",
    "files": [
      "electron/**",
      "www/**",
      "package.json"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "Pontaj-${version}-installer.exe"
    },
    "portable": {
      "artifactName": "Pontaj-${version}-portable.exe"
    }
  }
}
